################################################################################
# Local Terraform state files
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Terraform plan files
*.tfplan
*.tfplan.*

# Sensitive variable files
terraform.tfvars
*.auto.tfvars
*.auto.tfvars.json

# Crash logs
crash.log
crash.*.log

